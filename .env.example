# Kopieren nach .env (eigener Server) bzw. als Umgebungsvariablen bei Netlify eintragen.

# Pflicht: Laborcode für den Zugang (lang und nicht erratbar, z. B. 4 zufällige Wörter)
LAB_CODE=

# Optional: KI-Fragen in Wissen und Fällen (Schlüssel von console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Startdaten beim allerersten Start: demo (Beispiellabor) oder leer (nur Stammdaten + Zugang "Laborleitung", PIN 1234)
DATA_START=demo
# LAB_NAME=Mein Dentallabor

# Nur eigener Server:
# PORT=8080
# DATA_DIR=data
